# EGA Update Console — per-job runner USER-unit template (SPEC §8, CONTRACTS §8-§9).
#
# DOCUMENTATION OF THE TRANSIENT UNIT SHAPE ONLY — DO NOT START THIS
# TEMPLATE DIRECTLY (not via `systemctl --user start` either). Installed by
# deploy/scripts/install.sh to ubuntu's ~/.config/systemd/user as
# ega-update-runner@.service for shape reference only. Requires
# `loginctl enable-linger ubuntu` so the user manager exists at boot.
#
# The dispatcher (running as ubuntu) uses transient units ONLY:
#
#   systemd-run --user --collect \
#     --unit=ega-update-job-<32hex-uuid>.service \
#     --working-directory=<resolved-release> \
#     --setenv=EGA_CONFIG_FILE=... \
#     --setenv=EGA_ATTEMPT_NONCE=... --setenv=<allow-listed owner env> \
#     (--setenv covers the canonical OwnerExecutionContract: PATH, HOME,
#     USER, LOGNAME, XDG_RUNTIME_DIR, DBUS_SESSION_BUS_ADDRESS, LANG,
#     LC_ALL, LC_CTYPE, TZ — identical keys for probes and phases) \
#     --property=KillMode=control-group \
#     --property=Restart=no \
#     --property=NoNewPrivileges=no \
#     <release-venv-python> -m backend.app.worker.runner <job-id> <nonce>
#
# where <job-id> is the full job UUID and <nonce> is the attempt claim token
# (runner refuses mismatches with exit 6 before any mutation). The recorded
# jobs.runner_unit is the transient ega-update-job-<32hex-uuid>.service name
# (full UUID hex, never shortid), inspected with `systemctl --user
# is-active/show` (as ubuntu); never the system manager.
#
# Cgroup containment, timeouts, and no-restart semantics mirror the system
# template (systemd/ega-update-runner@.service), which is likewise
# documentation-only.

[Unit]
Description=EGA Update Console job runner <job-id> <nonce> (user unit shape documentation — do not start directly)
Documentation=file:/opt/ega-update/current/docs/RUNBOOK.md
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/ega-update/current
EnvironmentFile=/etc/ega-update/worker.env
ExecStart=/opt/ega-update/current/venv/bin/python -m backend.app.worker.runner <job-id> <nonce>
KillMode=control-group
KillSignal=SIGTERM
FinalKillSignal=SIGKILL
TimeoutStopSec=60
Restart=no
# F04 privilege truth: job execution runs WITHOUT NoNewPrivileges so the
# inventoried Hermes sudo path (`sudo -n systemctl restart <unit>` under
# the narrow sudoers allow-list in deploy/etc/sudoers.d/) can elevate.
# no_new_privs would ignore setuid and break every Hermes system-unit
# restart. The API/worker services (which never elevate) keep
# NoNewPrivileges=true; only job execution is NNP-off, and the owner
# contract fingerprint binds runner_no_new_privileges=false (plus
# privilege_profile=owner-exec-nnp-off) so any change invalidates plans.
NoNewPrivileges=no
PrivateTmp=true

[Install]
WantedBy=default.target
