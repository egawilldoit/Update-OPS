# EGA Update Console — persistent Cloudflare Tunnel (SPEC §2, §12).
#
# Routes ONLY the single dedicated console hostname to the loopback API:
#   ingress: <dedicated-hostname> -> http://127.0.0.1:$EGA_LISTEN_PORT
# (port rendered from config at install into
# /etc/systemd/system/ega-update-api.service.d/10-port.conf; the tunnel
# ingress service port must match the effective API port — see
# deploy/scripts/install.sh and RUNBOOK §1).
# No other hostname, path, or origin is routed by this tunnel.
#
# Lifecycle independence (R35): the tunnel is INDEPENDENT of the API unit.
# It uses Wants (never BindsTo) so an API restart/reinstall never
# permanently stops the tunnel: the tunnel keeps running, reconnects, and
# resumes routing once the API is healthy again. Restart=always +
# RestartSec keeps it persistent across transient cloudflared failures.
#
# Protection model:
# - The whole hostname is gated by a Cloudflare Access policy (owner
#   identities only). Access is configured BEFORE the hostname is published.
# - The API additionally validates Cf-Access-Jwt-Assertion itself
#   (backend/app/auth.py): RS256, fixed audience, configured issuer,
#   expiry, owner allow-list, fail closed. Never trust an email header alone.
# - Authenticated API responses carry `Cache-Control: no-store`; the tunnel/
#   zone config bypasses cache for /api/* (see cloudflared config.yml
#   originRequest + zone cache rule documented in docs/RUNBOOK.md).
# - SSH access is preserved independently of this tunnel.
#
# Credentials: /etc/ega-update/cloudflared/credentials.json (0600,
# root:ega-update or ega-update owner per install.sh). The tunnel token, if
# used instead of a credentials file, lives in /etc/ega-update/tunnel.env
# (0600) and is never logged.
#
# Pre-start validation (R35): ExecStartPre runs the release validator's
# tunnel checks with the RELEASE venv python. Missing venv python refuses
# start (fail closed — no system-python fallback for validation).

[Unit]
Description=EGA Update Console Cloudflare Tunnel (dedicated hostname only)
Documentation=file:/opt/ega-update/current/docs/RUNBOOK.md
After=network.target
Wants=network.target ega-update-api.service

[Service]
Type=simple
User=ega-update
Group=ega-update
# Tunnel credentials: credentials.json (0600) via config.yml
# credentials-file, plus optional token env file below (0600, never logged).
# The config.yml generated by install.sh contains ONLY a placeholder hostname
# (CHANGEME-*); the validator refuses to route while any placeholder remains
# (see RUNBOOK §1). Replace placeholders before enabling routing.
EnvironmentFile=-/etc/ega-update/tunnel.env
ExecStartPre=/opt/ega-update/current/venv/bin/python /opt/ega-update/current/deploy/etc/validate-release.py --release /opt/ega-update/current --config /etc/ega-update/config.json --only tunnel
ExecStart=/usr/bin/cloudflared tunnel --config /etc/ega-update/cloudflared/config.yml run
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/etc/ega-update/cloudflared

[Install]
WantedBy=multi-user.target
