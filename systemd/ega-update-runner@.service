# EGA Update Console — per-job runner template (SPEC §8, CONTRACTS §8-§9).
#
# DOCUMENTATION OF THE TRANSIENT UNIT SHAPE ONLY — DO NOT ENABLE OR START
# THIS TEMPLATE DIRECTLY. There is exactly one canonical launch mechanism,
# owned by the dispatcher (running as ubuntu) via the ubuntu USER manager:
#
#   systemd-run --user --collect \
#     --unit=ega-update-job-<32hex-uuid>.service \
#     --working-directory=<resolved-release> \
#     --setenv=EGA_CONFIG_FILE=... \
#     --setenv=EGA_ATTEMPT_NONCE=... --setenv=<allow-listed owner env> \
#     (--setenv covers the canonical OwnerExecutionContract: PATH, HOME,
#     USER, LOGNAME, XDG_RUNTIME_DIR, DBUS_SESSION_BUS_ADDRESS, LANG,
#     LC_ALL, LC_CTYPE, TZ — identical keys for probes and phases) \
#     --property=KillMode=control-group \
#     --property=Restart=no \
#     <release-venv-python> -m backend.app.worker.runner <job-id> <nonce>
#
# where <job-id> is the full job UUID and <nonce> is the attempt claim token
# (jobs.claim_with_nonce; runner refuses mismatches with exit 6 before any
# mutation). The recorded jobs.runner_unit is the transient
# ega-update-job-<32hex-uuid>.service name (full UUID hex, never shortid). A
# dispatch retry inspects that recorded unit (`systemctl --user is-active/
# show` as ubuntu) instead of spawning a duplicate.
#
# This file documents the execution environment (cgroup containment,
# timeouts, no-restart) for the transient unit above; it is NOT an alternate
# launch path. `systemctl start ega-update-runner@<anything>` is unsupported
# and will not carry the canonical <job-id> <nonce> argv.
#
# Cgroup containment: updater descendants remain in the job's cgroup.
# - Runner crash: systemd terminates remaining cgroup processes; the
#   dispatcher/worker reconciles unit state and records `interrupted`
#   unless a persisted completion receipt proves the outcome.
# - Hard timeout: the runner terminates the job cgroup gracefully
#   (SIGTERM), then forcibly (SIGKILL) after the configured grace period;
#   records possible partial installation + bounded recovery checks.
#   No retry, no browser cancellation in V1.
#
# TimeoutStopSec below bounds graceful stop of the runner itself; per-step
# procedure timeouts come from adapter plan().timeouts (see
# backend/app/adapters/base.py ADAPTER_TIMEOUT_DEFAULTS).
#
# User-manager requirement: `loginctl enable-linger ubuntu` must be active
# (see deploy/scripts/install.sh) or the user manager — and all --user
# job units — dies with the last SSH session.

[Unit]
Description=EGA Update Console job runner <job-id> <nonce> (transient shape documentation — do not start directly)
Documentation=file:/opt/ega-update/current/docs/RUNBOOK.md
After=network.target ega-update-worker.service
Wants=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/ega-update/current
EnvironmentFile=/etc/ega-update/worker.env
ExecStart=/opt/ega-update/current/venv/bin/python -m backend.app.worker.runner <job-id> <nonce>
# Graceful stop first, then SIGKILL. KillMode=control-group ensures
# updater descendants in the job cgroup are terminated together.
KillMode=control-group
KillSignal=SIGTERM
FinalKillSignal=SIGKILL
TimeoutStopSec=60
# One-shot jobs must not restart: an exited runner is reconciled, never
# re-executed (API/dispatcher restart resumes observation only).
Restart=no
NoNewPrivileges=true
PrivateTmp=true
