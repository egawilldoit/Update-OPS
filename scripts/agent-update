#!/usr/bin/env bash
# agent-update — dispatcher entry point for per-tool updates (subagent B owned).
#
#   scripts/agent-update inspect codex
#   scripts/agent-update plan opencode
#   scripts/agent-update apply hermes --plan-id <id> --job-id <uuid>
#   scripts/agent-update verify t3
#
# Thin Bash wrapper around the Python adapter implementation
# (backend/app/adapters/*, backend/app/worker/runner.py). Subprocesses use
# fixed argument arrays with shell=False; never eval or bash -lc with
# generated text. No update-all; no all/force/command arguments.
#
# Locking: read-only paths (inspect/plan/verify) never take the exclusive
# lock. The apply path checks that locking is supported (missing flock blocks
# mutation) but does not hold the execution lock itself — the job runner owns
# it for the full procedure, so wrappers never deadlock against it. Direct CLI
# invocation goes through that same runner.
#
# Every operation emits one JSON result on stdout and redacted log lines on
# stderr (separate stream). Exit codes: 0 verified success or already-current,
# 2 invalid request, 3 blocked, 4 installation failure, 5 verification
# failure, 6 interrupted/recovery required.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=common.sh
. "${SCRIPT_DIR}/common.sh"

ACTION="${1:-}"
TOOL="${2:-}"
if [ "$#" -ge 2 ]; then
    shift 2
else
    shift "$#" 2>/dev/null || true
fi

if [ -z "${ACTION}" ] || [ -z "${TOOL}" ]; then
    common_usage
    exit 2
fi

if ! common_reject_banned_args "$ACTION" "$TOOL" "$@"; then
    exit 2
fi

case "$ACTION" in
    inspect|plan|apply|verify) ;;
    *)
        echo "agent-update: unknown action '$ACTION'" >&2
        common_usage
        exit 2
        ;;
esac

if ! common_is_valid_tool "$TOOL"; then
    echo "agent-update: unknown tool '$TOOL'" >&2
    common_usage
    exit 2
fi

PLAN_ID=""
JOB_ID=""
while [ "$#" -gt 0 ]; do
    case "${1:-}" in
        --plan-id)
            if [ "$#" -lt 2 ] || [ -z "${2:-}" ]; then
                echo "agent-update: --plan-id requires a value" >&2
                exit 2
            fi
            PLAN_ID="$2"
            shift 2
            ;;
        --job-id)
            if [ "$#" -lt 2 ] || [ -z "${2:-}" ]; then
                echo "agent-update: --job-id requires a value" >&2
                exit 2
            fi
            JOB_ID="$2"
            shift 2
            ;;
        --*)
            echo "agent-update: unknown flag '$1'" >&2
            exit 2
            ;;
        *)
            echo "agent-update: unexpected argument '$1'" >&2
            exit 2
            ;;
    esac
done

# IDs are opaque handles, not paths: reject path characters up front.
case "$PLAN_ID$JOB_ID" in
    *"/"*|*"\"*|*\.\.*)
        echo "agent-update: IDs must not contain path characters" >&2
        exit 2
        ;;
esac

case "$ACTION" in
    inspect|plan|verify)
        if [ -n "$PLAN_ID" ] || [ -n "$JOB_ID" ]; then
            echo "agent-update: $ACTION takes no --plan-id/--job-id" >&2
            exit 2
        fi
        ;;
    apply)
        if [ -z "$PLAN_ID" ] || [ -z "$JOB_ID" ]; then
            echo "agent-update: apply requires --plan-id <id> --job-id <uuid>" >&2
            exit 2
        fi
        # Mutating path: locking support is mandatory. This checks availability
        # only; the runner owns the execution lock during the procedure.
        if ! common_require_flock; then
            exit 3
        fi
        ;;
esac

REPO_ROOT="$(common_repo_root)"

# Delegated Python stage with an explicit status check (errexit-safe: the
# invocation is the `if` condition, so nonzero exits are captured, never
# masked by a suppressed errexit context).
PY_STATUS=0
if ! AGENT_UPDATE_REPO="$REPO_ROOT" PYTHONPATH="$REPO_ROOT" python3 - "$ACTION" "$TOOL" "$PLAN_ID" "$JOB_ID" <<'PYEOF'
import json
import os
import sqlite3
import subprocess
import sys
import uuid
from datetime import datetime, timezone

ACTION, TOOL, PLAN_ID, JOB_ID = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4]
REPO = os.environ.get("AGENT_UPDATE_REPO", "")
if REPO and REPO not in sys.path:
    sys.path.insert(0, REPO)

from backend.app.adapters.registry import get_adapter, parse_semver
from backend.app.redaction import redact_text

STARTED = datetime.now(timezone.utc).isoformat()
NONTERMINAL = ("accepted", "preflight", "backup", "updating", "verifying")


def utcnow():
    return datetime.now(timezone.utc).isoformat()


def is_valid_uuid(value):
    # Same rule as the API (backend/app/api/deps.py): uuid.UUID parses.
    try:
        uuid.UUID(str(value))
        return True
    except Exception:
        return False


def _load_known_secrets():
    # Known secret values for redaction (never logged). Reads
    # $EGA_SECRETS_FILE (default /etc/ega-update/secrets.env) as KEY=VALUE
    # lines; pattern-only redaction stays as the floor, values are the
    # ceiling. Returns () on any doubt.
    path = os.environ.get("EGA_SECRETS_FILE", "/etc/ega-update/secrets.env")
    if not path:
        path = "/etc/ega-update/secrets.env"
    values = []
    try:
        with open(path, "r", encoding="utf-8") as fh:
            for raw in fh:
                line = raw.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                if line.startswith("export "):
                    line = line[len("export "):].strip()
                _key, _, _val = line.partition("=")
                _val = _val.strip()
                if len(_val) >= 2 and _val[0] == _val[-1] and _val[0] in ("'", '"'):
                    _val = _val[1:-1]
                if len(_val) >= 4:
                    values.append(_val)
    except OSError:
        return ()
    except Exception:
        return ()
    return tuple(values)


KNOWN_SECRETS = _load_known_secrets()


def log_line(message):
    try:
        sys.stderr.write(redact_text(str(message), KNOWN_SECRETS) + "\n")
    except Exception:
        sys.stderr.write(str(message)[:2000] + "\n")
    sys.stderr.flush()


def emit(tool, action, job_id, before, target, mode, after, state, checks,
         error_code, started, exit_code):
    payload = {
        "schema_version": 1,
        "tool": tool,
        "action": action,
        "job_id": job_id,
        "before_version": before or "",
        "requested_target": target or "",
        "target_mode": mode or "",
        "after_version": after or "",
        "state": state,
        "checks": checks or [],
        "error_code": error_code or "",
        "timestamps": {"started_at": started, "finished_at": utcnow()},
    }
    sys.stdout.write(json.dumps(payload, sort_keys=True) + "\n")
    sys.stdout.flush()
    return exit_code


def fail(action, tool, job_id, code, exit_code, before="", target="", mode=""):
    log_line("%s %s blocked: %s" % (action, tool, code))
    return emit(tool, action, job_id, before, target, mode, "", "blocked", [],
                code, STARTED, exit_code)


def db_path():
    explicit = os.environ.get("EGA_DB_PATH", "").strip()
    if explicit:
        return explicit
    cfg_file = os.environ.get("EGA_CONFIG_FILE", "").strip()
    if cfg_file and os.path.exists(cfg_file):
        try:
            with open(cfg_file, "r", encoding="utf-8") as fh:
                data = json.load(fh)
            candidate = str(data.get("db_path", "") or "").strip()
            if candidate:
                return candidate
        except Exception:
            pass
    return "/var/lib/ega-update/state.db"


def log_dir():
    explicit = os.environ.get("EGA_LOG_DIR", "").strip()
    if explicit:
        return explicit
    return "/var/lib/ega-update/logs"


def checks_of(items):
    out = []
    for item in items or []:
        get = (lambda name, default="": getattr(item, name, default))
        if isinstance(item, dict):
            out.append({
                "name": str(item.get("name", "")),
                "result": str(item.get("result", "unknown")),
                "mandatory": bool(item.get("mandatory", True)),
                "summary": str(item.get("summary", ""))[:1000],
            })
        else:
            out.append({
                "name": str(get("name", "")),
                "result": str(get("result", "unknown")),
                "mandatory": bool(get("mandatory", True)),
                "summary": str(get("summary", ""))[:1000],
            })
    return out


try:
    adapter = get_adapter(TOOL)
except KeyError:
    sys.stderr.write("agent-update: unknown tool\n")
    sys.exit(emit(TOOL, ACTION, JOB_ID, "", "", "", "", "blocked", [],
                   "invalid_request", STARTED, 2))

adapter._emit = lambda stream, line: log_line("[%s] %s" % (stream, line))

if ACTION == "inspect":
    # Read-only: installation identity, version, source/service metadata.
    result = adapter.inspect()
    log_line("inspect %s version=%s kind=%s" % (
        TOOL, result.version or "?", result.install_kind or "?"))
    sys.exit(emit(TOOL, ACTION, "", result.version, "", "", "", "inspected",
                   [], "", STARTED, 0))

if ACTION == "plan":
    # Read-only preview. Registry metadata reads are allowed and labeled;
    # explicit native checks that fetch Git metadata are labeled as such.
    discovery = adapter.discover()
    plan = adapter.plan()
    if TOOL in ("opencode", "t3"):
        log_line("note: registry metadata retrieval is read-only and labeled; "
                 "no install/download performed")
    if TOOL == "hermes":
        log_line("note: native `hermes update --plan/--check` may fetch Git "
                 "metadata (labeled); no install performed")
    if not discovery.available or not plan.steps:
        reason = discovery.unknown_reason or getattr(plan, "restart_impact", "")
        log_line("plan %s blocked: %s" % (TOOL, reason))
        code = "install_method_unsupported" if (
            "install_method_unsupported" in reason or "inventory gate" in reason
        ) else "unavailable"
        sys.exit(emit(TOOL, ACTION, "", "", discovery.target,
                       discovery.target_mode, "", "blocked",
                       [], code, STARTED, 3))
    log_line("plan %s target=%s mode=%s already_current=%s" % (
        TOOL, plan.target, plan.target_mode, plan.already_current))
    sys.exit(emit(TOOL, ACTION, "", "", plan.target, plan.target_mode, "",
                   "planned", [], "", STARTED, 0))

if ACTION == "verify":
    # Read-only: structured mandatory check results, never mutates.
    result = adapter.verify()
    for item in result.checks:
        name = item["name"] if isinstance(item, dict) else getattr(item, "name", "?")
        res = item["result"] if isinstance(item, dict) else getattr(item, "result", "?")
        summary = item["summary"] if isinstance(item, dict) else getattr(item, "summary", "")
        log_line("verify %s: %s=%s %s" % (TOOL, name, res, summary[:200]))
    state = "verified" if result.passed else "health_failed"
    sys.exit(emit(TOOL, ACTION, "", "", "", "", result.version, state,
                   checks_of(result.checks),
                   "" if result.passed else (result.error_code or "health_failed"),
                   STARTED, 0 if result.passed else 5))

# -- apply: trusted server plan gate, then the shared runner ---------------
if TOOL == "claude":
    sys.exit(fail(ACTION, TOOL, JOB_ID, "install_method_unsupported", 3))

if not PLAN_ID or not JOB_ID:
    log_line("apply: invalid plan/job ids")
    sys.exit(emit(TOOL, ACTION, JOB_ID, "", "", "", "", "blocked", [],
                   "invalid_request", STARTED, 2))

# Strict JOB_ID validation (same UUID rule as the API) before any path join.
if not is_valid_uuid(JOB_ID):
    log_line("apply: invalid job id (must be UUID)")
    sys.exit(emit(TOOL, ACTION, JOB_ID, "", "", "", "", "blocked", [],
                   "invalid_request", STARTED, 2))

path = db_path()
try:
    conn = sqlite3.connect("file:%s?mode=ro" % path, uri=True, timeout=5.0)
    conn.row_factory = sqlite3.Row
except Exception as exc:
    log_line("apply: job store unreadable: %s" % exc)
    sys.exit(emit(TOOL, ACTION, JOB_ID, "", "", "", "", "blocked", [],
                   "unavailable", STARTED, 3))

try:
    job = conn.execute("SELECT * FROM jobs WHERE id=?", (JOB_ID,)).fetchone()
    plan = conn.execute("SELECT * FROM plans WHERE id=?", (PLAN_ID,)).fetchone()
    recovery = conn.execute(
        "SELECT COUNT(*) AS n FROM jobs WHERE recovery_required=1").fetchone()
    other = conn.execute(
        "SELECT id FROM jobs WHERE state IN (?,?,?,?,?) AND id != ? LIMIT 1",
        NONTERMINAL + (JOB_ID,)).fetchone()
finally:
    try:
        conn.close()
    except Exception:
        pass

if job is None or plan is None:
    log_line("apply: unknown plan or job id")
    sys.exit(emit(TOOL, ACTION, JOB_ID, "", "", "", "", "blocked", [],
                   "invalid_request", STARTED, 2))
job, plan = dict(job), dict(plan)
if job.get("plan_id") != PLAN_ID:
    log_line("apply: job does not reference the given plan")
    sys.exit(emit(TOOL, ACTION, JOB_ID, "", "", "", "", "blocked", [],
                   "invalid_request", STARTED, 2))
if plan.get("tool_id") != TOOL or job.get("tool_id") != TOOL:
    log_line("apply: plan/job tool mismatch")
    sys.exit(emit(TOOL, ACTION, JOB_ID, "", "", "", "", "blocked", [],
                   "invalid_request", STARTED, 2))
if plan.get("expires_at") and plan["expires_at"] <= utcnow():
    sys.exit(fail(ACTION, TOOL, JOB_ID, "stale_plan", 3,
                  before=job.get("before_version", ""),
                  target=plan.get("target", ""),
                  mode=plan.get("target_mode", "")))
if recovery and recovery["n"]:
    log_line("apply: recovery_required set; reconcile over SSH first")
    sys.exit(emit(TOOL, ACTION, JOB_ID, job.get("before_version", ""),
                   plan.get("target", ""), plan.get("target_mode", ""), "",
                   "blocked", [], "recovery_required", STARTED, 6))
if other is not None:
    log_line("apply: concurrent job %s active" % other["id"])
    sys.exit(fail(ACTION, TOOL, JOB_ID, "busy", 3,
                  before=job.get("before_version", ""),
                  target=plan.get("target", ""),
                  mode=plan.get("target_mode", "")))

target_mode = plan.get("target_mode", "")
target = plan.get("target", "")
if target_mode == "exact":
    if not target or parse_semver(target) is None:
        log_line("apply: unvalidated exact target")
        sys.exit(emit(TOOL, ACTION, JOB_ID, job.get("before_version", ""),
                       target, target_mode, "", "blocked", [],
                       "invalid_request", STARTED, 2))
elif target_mode == "native_latest":
    if TOOL not in ("hermes", "codex"):
        log_line("apply: native_latest unsupported for %s" % TOOL)
        sys.exit(emit(TOOL, ACTION, JOB_ID, job.get("before_version", ""),
                       target, target_mode, "", "blocked", [],
                       "invalid_request", STARTED, 2))
else:
    log_line("apply: unknown target mode")
    sys.exit(emit(TOOL, ACTION, JOB_ID, job.get("before_version", ""),
                   target, target_mode, "", "blocked", [],
                   "invalid_request", STARTED, 2))

TERMINAL = ("succeeded", "blocked", "failed", "health_failed", "interrupted")
receipt_path = os.path.join(log_dir(), "%s.receipt.json" % JOB_ID)


def read_receipt():
    try:
        with open(receipt_path, "r", encoding="utf-8") as fh:
            data = json.load(fh)
        return data if isinstance(data, dict) else None
    except Exception:
        return None


def exit_for(state):
    return {"succeeded": 0, "blocked": 3, "failed": 4,
            "health_failed": 5, "interrupted": 6}.get(state, 6)


if job.get("state") in TERMINAL:
    # Idempotent replay of the durable record; never re-executes.
    receipt = read_receipt()
    if receipt is None:
        log_line("apply: terminal job without receipt; reconcile over SSH")
        sys.exit(emit(TOOL, ACTION, JOB_ID, job.get("before_version", ""),
                       target, target_mode, job.get("after_version", ""),
                       "interrupted", [], "recovery_required", STARTED, 6))
    log_line("apply: replaying terminal state %s" % receipt.get("state"))
    sys.exit(emit(TOOL, ACTION, JOB_ID, receipt.get("before_version", ""),
                   target, target_mode, receipt.get("after_version", ""),
                   receipt.get("state", "interrupted"),
                   receipt.get("checks", []),
                   receipt.get("error_code", ""), STARTED,
                   exit_for(receipt.get("state"))))

if job.get("state") != "accepted" or job.get("started_at"):
    # A claimed/started but incomplete job must not be re-executed blindly:
    # the dispatcher inspects the recorded unit instead of spawning a
    # duplicate. Direct CLI follows the same rule.
    receipt = read_receipt()
    if receipt is not None and receipt.get("state") in TERMINAL:
        sys.exit(emit(TOOL, ACTION, JOB_ID, receipt.get("before_version", ""),
                       target, target_mode, receipt.get("after_version", ""),
                       receipt.get("state"), receipt.get("checks", []),
                       receipt.get("error_code", ""), STARTED,
                       exit_for(receipt.get("state"))))
    log_line("apply: job %s already claimed; refusing duplicate execution" % JOB_ID)
    sys.exit(emit(TOOL, ACTION, JOB_ID, job.get("before_version", ""),
                   target, target_mode, "", "blocked", [], "busy", STARTED, 3))

# Fresh accepted job: hand to the shared runner (it owns the execution lock).
log_line("apply %s: dispatching job %s plan %s target=%s" % (
    TOOL, JOB_ID, PLAN_ID, target or "native-latest"))
runner_cmd = [sys.executable, "-m", "backend.app.worker.runner", JOB_ID]
try:
    proc = subprocess.run(runner_cmd, cwd=REPO, shell=False, check=False,
                          stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                          text=True, timeout=86400)
except subprocess.TimeoutExpired:
    log_line("apply: runner exceeded outer bound; reconcile over SSH")
    sys.exit(emit(TOOL, ACTION, JOB_ID, job.get("before_version", ""),
                   target, target_mode, "", "interrupted", [],
                   "interrupted", STARTED, 6))
except OSError as exc:
    log_line("apply: runner spawn failed: %s" % exc)
    sys.exit(emit(TOOL, ACTION, JOB_ID, job.get("before_version", ""),
                   target, target_mode, "", "blocked", [],
                   "worker_unavailable", STARTED, 3))
for line in (proc.stdout or "").splitlines():
    log_line("[runner] %s" % line[:2000])
for line in (proc.stderr or "").splitlines():
    log_line("[runner] %s" % line[:2000])
log_line("apply: runner exit=%d" % proc.returncode)

receipt = read_receipt()
if receipt is None:
    log_line("apply: no completion receipt; reconcile over SSH")
    sys.exit(emit(TOOL, ACTION, JOB_ID, job.get("before_version", ""),
                   target, target_mode, "", "interrupted", [],
                   "interrupted", STARTED, 6))
sys.exit(emit(TOOL, ACTION, JOB_ID, receipt.get("before_version", ""),
               target, target_mode, receipt.get("after_version", ""),
               receipt.get("state", "interrupted"),
               receipt.get("checks", []),
               receipt.get("error_code", ""), STARTED,
               exit_for(receipt.get("state"))))
PYEOF
then
    PY_STATUS=$?
else
    PY_STATUS=0
fi

exit "$PY_STATUS"
