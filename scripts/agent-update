#!/usr/bin/env bash
# agent-update — thin compat dispatcher to backend.app.cli (UI/DEPLOY owned).
#
#   scripts/agent-update inspect codex
#   scripts/agent-update plan opencode
#   scripts/agent-update apply hermes --plan-id <id> --job-id <uuid>
#   scripts/agent-update verify t3
#
# Thin wrapper only (R12/R13): resolves the release root (script dir ->
# /opt/ega-update/current) and execs the release venv CLI so the JSON
# envelope on stdout and process exits 0/2/3/4/5/6 propagate bit-identically.
# No heredoc-python here, no status capture. CLI owns locking, the single
# active slot, idempotency, and canonical dispatch (`apply` = reserve +
# observe canonical dispatch, never runs the runner directly).
#
# Action names stay compatible with the historic dispatcher and map 1:1 to
# cli verbs: inspect|plan|apply|verify -> cli <verb> --tool <tool>.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=common.sh
. "${SCRIPT_DIR}/common.sh"

ACTION="${1:-}"
TOOL="${2:-}"
if [ "$#" -ge 2 ]; then
    shift 2
else
    shift "$#" 2>/dev/null || true
fi

if [ -z "${ACTION}" ] || [ -z "${TOOL}" ]; then
    common_usage
    exit 2
fi

if common_reject_banned_args "$ACTION" "$TOOL" "$@"; then
    :
else
    exit 2
fi

case "$ACTION" in
    inspect|plan|apply|verify) ;;
    *)
        echo "agent-update: unknown action '$ACTION'" >&2
        common_usage
        exit 2
        ;;
esac

if common_is_valid_tool "$TOOL"; then
    :
else
    echo "agent-update: unknown tool '$TOOL'" >&2
    common_usage
    exit 2
fi

# Explicit arg mapping to cli flags (no blind passthrough of unknown flags).
PLAN_ID=""
JOB_ID=""
WANT_ACK=""
IDEM_KEY=""
WAIT_SECS=""
CLEAR_RECOVERY=0
while [ "$#" -gt 0 ]; do
    case "${1:-}" in
        --plan-id)
            if [ "$#" -lt 2 ] || [ -z "${2:-}" ]; then
                echo "agent-update: --plan-id requires a value" >&2
                exit 2
            fi
            PLAN_ID="$2"
            shift 2
            ;;
        --job-id)
            if [ "$#" -lt 2 ] || [ -z "${2:-}" ]; then
                echo "agent-update: --job-id requires a value" >&2
                exit 2
            fi
            JOB_ID="$2"
            shift 2
            ;;
        --ack)
            WANT_ACK="--ack"
            shift 1
            ;;
        --no-ack)
            WANT_ACK="--no-ack"
            shift 1
            ;;
        --idempotency-key)
            if [ "$#" -lt 2 ] || [ -z "${2:-}" ]; then
                echo "agent-update: --idempotency-key requires a value" >&2
                exit 2
            fi
            IDEM_KEY="$2"
            shift 2
            ;;
        --wait-secs)
            if [ "$#" -lt 2 ] || [ -z "${2:-}" ]; then
                echo "agent-update: --wait-secs requires a value" >&2
                exit 2
            fi
            WAIT_SECS="$2"
            shift 2
            ;;
        --clear-recovery)
            CLEAR_RECOVERY=1
            shift 1
            ;;
        --*)
            echo "agent-update: unknown flag '$1'" >&2
            exit 2
            ;;
        *)
            echo "agent-update: unexpected argument '$1'" >&2
            exit 2
            ;;
    esac
done

# IDs are opaque handles, not paths: reject path characters up front.
case "$PLAN_ID$JOB_ID$IDEM_KEY" in
    *"/"*|*"\"*|*\.\.*)
        echo "agent-update: IDs must not contain path characters" >&2
        exit 2
        ;;
esac

case "$ACTION" in
    inspect|plan|verify)
        if [ -n "$PLAN_ID" ] || [ -n "$JOB_ID" ]; then
            echo "agent-update: $ACTION takes no --plan-id/--job-id" >&2
            exit 2
        fi
        ;;
    apply)
        if [ -z "$PLAN_ID" ] || [ -z "$JOB_ID" ]; then
            echo "agent-update: apply requires --plan-id <id> --job-id <uuid>" >&2
            exit 2
        fi
        ;;
esac

RELEASE="$(common_release_root)"
CLI_PY="$(common_release_python "$RELEASE")"

CLI_ARGS=()
if [ -n "$PLAN_ID" ]; then
    CLI_ARGS+=("--plan-id" "$PLAN_ID")
fi
if [ -n "$JOB_ID" ]; then
    CLI_ARGS+=("--job-id" "$JOB_ID")
fi
if [ -n "$WANT_ACK" ]; then
    CLI_ARGS+=("$WANT_ACK")
fi
if [ -n "$IDEM_KEY" ]; then
    CLI_ARGS+=("--idempotency-key" "$IDEM_KEY")
fi
if [ -n "$WAIT_SECS" ]; then
    CLI_ARGS+=("--wait-secs" "$WAIT_SECS")
fi
if [ "$CLEAR_RECOVERY" = "1" ]; then
    CLI_ARGS+=("--clear-recovery")
fi

# exec so the CLI exit code (0/2/3/4/5/6) and stdout envelope propagate
# bit-identically; no shell status capture in between.
exec "$CLI_PY" -m backend.app.cli "$ACTION" --tool "$TOOL" "${CLI_ARGS[@]}"
